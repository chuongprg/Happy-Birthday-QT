rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      // Anyone visiting the site can add a photo record — the photo itself
      // is a compressed JPEG data URL stored right on the document (no
      // Firebase Storage, which needs the paid Blaze plan just to create a
      // bucket), so it's capped well under Firestore's 1 MiB document limit.
      allow create: if request.resource.data.keys().hasOnly(
        ['giftIndex', 'giftTitle', 'sessionId', 'imageData', 'capturedAt']
      ) && request.resource.data.imageData.size() < 900000;
      // Only the signed-in admin can browse or remove records.
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    match /meta/pickupLocation {
      // One shared answer (the dinner-day pickup spot) — anyone with the
      // link can read the current value, and set it within a sane size
      // limit so it can't be abused as free-form storage.
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['answer', 'updatedAt'])
        && request.resource.data.answer is string
        && request.resource.data.answer.size() < 300;
    }

    match /youtubeTracks/{trackId} {
      // A shared, editable-by-anyone playlist add-on — both people can add a
      // song by YouTube link and remove one, no login needed (same trust
      // model as the rest of this visitor-facing site).
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['videoId', 'title', 'addedAt'])
        && request.resource.data.videoId is string
        && request.resource.data.videoId.size() == 11
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200;
      allow delete: if true;
      allow update: if false;
    }

    match /locketPhotos/{photoId} {
      // The Locket-style "moments" widget on the main site — a shared photo
      // library both people can browse and delete from, no admin login
      // needed (unlike the gift-quest `photos` collection above). Same
      // inline-data-URL storage as `photos` — no Firebase Storage bucket
      // needed.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
        ['visitorId', 'imageData', 'capturedAt']
      ) && request.resource.data.imageData.size() < 900000;
      allow delete: if true;
      allow update: if false;
    }
  }
}
