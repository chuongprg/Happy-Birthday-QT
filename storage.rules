// Unused — the app no longer uses Firebase Storage at all (photos are
// stored inline in Firestore instead, since Storage now requires the paid
// Blaze plan just to create a bucket). Kept only in case you switch back to
// real Storage later; nothing needs to publish these rules for the app to work.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{sessionId}/{fileName} {
      // Anyone visiting the site can upload a photo (visitors never log in).
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Only the signed-in admin can view or remove uploaded photos.
      allow read, delete: if request.auth != null;
    }

    match /locket/{visitorId}/{fileName} {
      // The Locket-style moments widget — unlike the gift-quest photos
      // above, both people can browse and delete these themselves from the
      // main site, no admin login needed.
      allow read, delete: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
